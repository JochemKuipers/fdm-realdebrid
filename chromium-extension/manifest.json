{
  "manifest_version": 3,
  "name": "Real-Debrid Magnets for FDM",
  "version": "1.1.7",
  "description": "Capture magnet links, pick files, and watch Real-Debrid hand them to Free Download Manager.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "magnet",
      "name": "Real-Debrid Magnets for FDM",
      "uriTemplate": "chrome-extension://ijimlcmjkddnimablogpkmgopalomlfn/handler.html?url=%s"
    }
  ],
  "action": {
    "default_title": "Magnet dock",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/magnet-rd-logo-48.png",
      "128": "icons/magnet-rd-logo-128.png"
    }
  },
  "icons": {
    "48": "icons/magnet-rd-logo-48.png",
    "128": "icons/magnet-rd-logo-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com;"
  }
}
