{
  "manifest_version": 3,
  "name": "Real-Debrid Magnets for FDM",
  "version": "1.0.0",
  "description": "Capture magnet links in Firefox and send them to Free Download Manager for Real-Debrid processing.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fdm-realdebrid-magnets@jochem.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "notifications",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Real-Debrid magnets for FDM (enabled)",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png"
  }
}
